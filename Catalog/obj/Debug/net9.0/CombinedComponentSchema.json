          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "The model to use in the audio APIs. Enum contains the most popular models, for a full list see https://developers.openai.com/api/docs/models/all."
    },
    "embeddingModel": {
      "anyOf": [
        {
          "enum": [
            "text-embedding-3-large",
            "text-embedding-3-small"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "The model to use in the embeddings APIs. Enum contains the most popular models, for a full list see https://developers.openai.com/api/docs/models/all."
    },
    "imageModel": {
      "anyOf": [
        {
          "enum": [
            "gpt-image-1.5",
            "gpt-image-1",
            "gpt-image-1-mini"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "The model to use in the image generation APIs. Enum contains the most popular models, for a full list see https://developers.openai.com/api/docs/models/all."
    },
    "moderationModel": {
      "anyOf": [
        {
          "enum": [
            "text-moderation-latest",
            "text-moderation-stable"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "description": "The model to use in the content moderation APIs. Enum contains the most popular models, for a full list see https://developers.openai.com/api/docs/models/all."
    },
